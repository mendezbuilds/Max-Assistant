{
  "name": "max-hub",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:generate": "npm run generate --workspace=@max/db",
    "db:migrate": "npm run migrate --workspace=@max/db",
    "db:seed": "npm run seed --workspace=@max/db",
    "dev:core": "npm run dev --workspace=@max/core",
    "dev:dashboard": "npm run dev --workspace=@max/dashboard",
    "build": "npm run build --workspace=@max/db && npm run build --workspace=@max/shared && npm run build --workspace=@max/core && npm run build --workspace=@max/dashboard"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
