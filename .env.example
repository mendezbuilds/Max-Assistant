# --- Shared ---
# SQLite file used by Prisma CLI (migrate/studio). Runtime code resolves its own
# absolute path relative to packages/db, so this mainly matters for `prisma` CLI commands.
DATABASE_URL="file:../../../data/max.db"

# --- apps/core ---
# Get this from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=""
# Claude API key, used by Max (the shared reasoning layer) once agents start calling it
ANTHROPIC_API_KEY=""
# job-scout's public/growth feed: the bot must be an admin of this channel.
# Get the channel's chat id by forwarding one of its posts to @userinfobot.
TELEGRAM_PUBLIC_CHANNEL_ID=""
# job-scout: Web3.career source. Free token, request at https://web3.career/web3-jobs-api
WEB3_CAREER_API_TOKEN=""
# job-scout: Covalent/GoldRush, for the on-chain (DEX) source. Reuse the same
# key already used for ChainTale if you have one.
GOLDRUSH_API_KEY=""
# MAX's text replies and voice-command transcription. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# MAX's text replies (general chat + agent routing). Get one at https://console.groq.com
GROQ_API_KEY=""

# --- Degen Hunter (apps/core + apps/dashboard) ---
# Dedicated Telegram bot token for Degen Hunter, separate from TELEGRAM_BOT_TOKEN above.
# Get this from @BotFather on Telegram (/newbot).
DEGEN_TELEGRAM_BOT_TOKEN=""
# The bot's own @username (no leading @), shown in dashboard links.
DEGEN_BOT_USERNAME=""
# Your own Telegram chatId — the ONLY chat the Degen Hunter bot will respond
# to, and the identity the web dashboard's wallet/trade routes are scoped
# to. Find it by messaging @userinfobot on Telegram. Required; without it
# the bot refuses all access and the dashboard's degen-hunter routes 401.
DEGEN_OWNER_CHAT_ID=""
# Encrypts burner-wallet private keys at rest (AES-256-GCM). Required — the
# app throws on startup use if this is missing, it will NOT fall back to an
# insecure default. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=""
# Solana RPC endpoint used for balance checks and real on-chain trades
# (mainnet). Defaults to the public mainnet-beta RPC if unset, which is
# rate-limited and not meant for real trading volume — get a dedicated
# endpoint (Helius, QuickNode, etc.) for real use.
SOLANA_RPC_ENDPOINT="https://api.mainnet-beta.solana.com"

# --- apps/dashboard ---
# Shared password gating the dashboard (single-user, Phase 0 auth)
DASHBOARD_PASSWORD="changeme"
# Random string used to sign the dashboard session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-this-to-a-long-random-string"
