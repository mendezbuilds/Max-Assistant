# --- Shared ---
# SQLite file used by Prisma CLI (migrate/studio). Runtime code resolves its own
# absolute path relative to packages/db, so this mainly matters for `prisma` CLI commands.
DATABASE_URL="file:../../../data/max.db"

# --- apps/core ---
# Get this from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=""
# Claude API key, used by Max (the shared reasoning layer) once agents start calling it
ANTHROPIC_API_KEY=""
# job-scout's public/growth feed: the bot must be an admin of this channel.
# Get the channel's chat id by forwarding one of its posts to @userinfobot.
TELEGRAM_PUBLIC_CHANNEL_ID=""
# job-scout: Web3.career source. Free token, request at https://web3.career/web3-jobs-api
WEB3_CAREER_API_TOKEN=""
# job-scout: Covalent/GoldRush, for the on-chain (DEX) source. Reuse the same
# key already used for ChainTale if you have one.
GOLDRUSH_API_KEY=""

# --- apps/dashboard ---
# Shared password gating the dashboard (single-user, Phase 0 auth)
DASHBOARD_PASSWORD="changeme"
# Random string used to sign the dashboard session cookie
SESSION_SECRET="change-this-to-a-long-random-string"
