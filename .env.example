# --- Shared ---
# SQLite file used by Prisma CLI (migrate/studio). Runtime code resolves its own
# absolute path relative to packages/db, so this mainly matters for `prisma` CLI commands.
DATABASE_URL="file:../../../data/max.db"

# --- apps/core ---
# Get this from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=""
# Claude API key, used by Max (the shared reasoning layer) once agents start calling it
ANTHROPIC_API_KEY=""

# --- apps/dashboard ---
# Shared password gating the dashboard (single-user, Phase 0 auth)
DASHBOARD_PASSWORD="changeme"
# Random string used to sign the dashboard session cookie
SESSION_SECRET="change-this-to-a-long-random-string"
