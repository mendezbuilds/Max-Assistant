generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One row per agent in the roster (see SPEC.md). Rows are seeded from
// packages/shared/src/agents.config.ts — never hand-edited — so the roster
// stays config-driven instead of hardcoded into migrations.
model Agent {
  id               Int       @id @default(autoincrement())
  key              String    @unique // stable slug, e.g. "job-scout"
  name             String
  icon             String // emoji or icon identifier shown on the dashboard card
  description      String
  phase            Int // build phase from SPEC.md (0-5)
  enabled          Boolean   @default(false)
  status           String    @default("idle") // idle | running | error | disabled
  lastActionAt     DateTime?
  lastActionSummary String?
  // Set by the dashboard's "Run now" button (or left null for a CLI trigger,
  // which runs directly and doesn't need this) to ask core to run this
  // agent immediately, outside its normal cron interval. Core's fast poll
  // (see apps/core/src/scheduler.ts) clears it back to null the moment it
  // picks the request up, so a slow run can't cause a second trigger.
  triggerRequestedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Central activity feed shown at the top of the dashboard. Every agent run
// (and core system events) writes here. agentKey is a loose reference to
// Agent.key (not a DB foreign key) so system-level entries (agentKey =
// "system") can be logged without needing a matching Agent row.
model ActivityLog {
  id        Int      @id @default(autoincrement())
  agentKey  String
  level     String   @default("info") // info | warn | error
  message   String
  meta      String? // optional JSON blob for structured detail
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([agentKey])
}

// Telegram chats that should receive notifications. Populated when someone
// sends /start to the bot; the shared notify() helper broadcasts to all of them.
model NotificationTarget {
  id        Int      @id @default(autoincrement())
  chatId    String   @unique
  label     String?
  createdAt DateTime @default(now())
}

// Generic de-dup ledger shared by every scout-style agent (job-scout today;
// alpha-scout/apartment-scout etc. later) so re-running a poll never re-alerts
// on something already sent. `externalId` is whatever the source's own item
// id is (e.g. a RemoteOK job id, a WWR listing URL).
model SeenItem {
  id         Int      @id @default(autoincrement())
  agentKey   String
  externalId String
  createdAt  DateTime @default(now())

  @@unique([agentKey, externalId])
  @@index([agentKey])
}

// ===== DEGEN HUNTER SPECIFIC TABLES =====

// Degen Hunter users - tracks user state and preferences
model DegenHunterUser {
  id        Int      @id @default(autoincrement())
  chatId    String   @unique // Telegram chat ID
  username  String?
  // Paper trading wallet balance (in SOL)
  paperWalletBalance Decimal @default(0)
  // PIN security (hashed)
  pinHash   String?  // PBKDF2-SHA256 hashed PIN (salt:hash, see @max/shared's degen-crypto.ts), null if not set
  // PIN brute-force lockout — see @max/shared's verifyPinWithLockout(), the
  // single entry point every PIN-gated action (bot + dashboard) goes
  // through. Shared across ALL PIN-gated actions for this user, not
  // per-action, so trying a guess via a different endpoint doesn't buy
  // extra attempts.
  pinFailedAttempts Int      @default(0)
  pinLockedUntil    DateTime?
  // User preferences
  alertsEnabled      Boolean @default(true)
  minScoreThreshold  Int     @default(50) // 0-100
  riskLevelFilter    String? // Comma-separated: "low,medium,high" or JSON array
  notifyOnNewTokens  Boolean @default(true)
  lastActive         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Degen Hunter wallet - tracks paper trading wallet and transaction history
model DegenHunterWallet {
  id              Int      @id @default(autoincrement())
  chatId          String   @unique // Telegram chat ID
  publicKey       String?  // Solana public key
  encryptedKey    String?  // Encrypted private key
  iv              String?  // Initialization vector for encryption
  balance         Decimal  @default(0) // Wallet balance in SOL
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Degen Hunter watchlist - tokens users are watching
model DegenHunterWatchlist {
  id        Int      @id @default(autoincrement())
  chatId    String   // Telegram chat ID
  tokenAddress String // Token contract address
  // Durable identity fields — preserved even if market data becomes unavailable
  tokenName    String?  // Token name at time of watch
  tokenSymbol  String?  // Token symbol at time of watch
  tokenChain   String?  // Chain (e.g. "solana")
  pairAddress  String?  // DEX pair address
  dexLabel     String?  // DEX name/label (e.g. "Raydium")
  discoverySource String? // How it was discovered
  addedAt   DateTime @default(now())
  @@unique([chatId, tokenAddress])
  @@index([chatId])
  @@index([tokenAddress])
}

// Degen Hunter muted tokens - tokens users have muted alerts for
model DegenHunterMutedToken {
  id        Int      @id @default(autoincrement())
  chatId    String   // Telegram chat ID
  tokenAddress String // Token contract address
  mutedAt   DateTime @default(now())
  @@unique([chatId, tokenAddress])
  @@index([chatId])
  @@index([tokenAddress])
}

// Degen Hunter ignored tokens - tokens users have ignored/hidden
model DegenHunterIgnoredToken {
  id        Int      @id @default(autoincrement())
  chatId    String   // Telegram chat ID
  tokenAddress String // Token contract address
  ignoredAt DateTime @default(now())
  @@unique([chatId, tokenAddress])
  @@index([chatId])
  @@index([tokenAddress])
}

// Degen Hunter real trading position
model DegenHunterPosition {
  id           Int      @id @default(autoincrement())
  chatId       String   // Telegram chat ID
  tokenAddress String   // Token contract address
  tokenSymbol  String   // Token symbol (e.g., "BONK")
  tokenAmount  Decimal  // Amount of tokens held
  amountSOL    Decimal  // Amount of SOL invested
  entryPriceUsd Decimal // Token price in USD at time of buy
  status       String   @default("OPEN") // "OPEN" or "CLOSED"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([chatId])
  @@index([tokenAddress])
  @@index([status])
}

// Degen Hunter recent tokens - cache of recently seen tokens for button callbacks
model DegenHunterRecentToken {
  id        Int      @id @default(autoincrement())
  tokenId   String   @unique // Unique token identifier from agent
  tokenData String   // Full token data as JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tokenId])
}